# BizHisab AI backend — production env example.
# Copy to `.env` for local dev only. In production, inject via the host
# platform's secret manager (Fly secrets, Render env vars, GCP Secret Manager,
# AWS SSM, etc.) — DO NOT commit a real `.env`.

# Groq API key — get yours at https://console.groq.com/keys
GROQ_API_KEY=

# Path to a Firebase Admin SDK service-account JSON. In production, mount
# this file via a secret volume (e.g. Fly secrets, GCP Secret Manager →
# /var/run/secrets/firebase.json) and point this var at it.
FIREBASE_CREDENTIALS_PATH=/var/run/secrets/firebase.json

# Groq model — leave default unless Groq retires it.
GROQ_MODEL=openai/gpt-oss-20b

# Per-user AI rate limit.
AI_RATE_LIMIT_REQUESTS=20
AI_RATE_LIMIT_WINDOW_SECONDS=60

# CORS — in production, restrict to known origins (comma-separated). For
# mobile clients you can keep "*" because the SDK does not send Origin.
AI_CORS_ORIGINS=*